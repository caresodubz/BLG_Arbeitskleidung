<Window x:Class="BLG_Arbeitskleidung.Views.BestandAnzeigen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BLG_Arbeitskleidung.Views"
        mc:Ignorable="d"
        Title="BestandAnzeigen" Height="800" Width="1400" Background="#E9F0FF">
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#A3D2FF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button
               Grid.Column="0"
               Grid.Row="0"
               Height="80"
               Width="150"  
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Content="AUSGABE"
               FontSize="20"
               FontWeight="Medium"
               BorderThickness="0"
               Background="#E9F0FF"
            />

            <Button 
               Grid.Column="0"
               Grid.Row="1"
               Height="80"
               Width="150"  
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Content="EINLAGERN"
               FontSize="20"
               FontWeight="Medium"
               BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#A3D2FF"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E9F0FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button 
                   Background="#A3D2FF"
                   Grid.Column="0"
                   Grid.Row="2"
                   Height="80"
                   Width="150"  
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"            
                   FontSize="20"
                   FontWeight="Medium"
                   BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="BESTAND" 
                  TextAlignment="Center"/>

                    <TextBlock Text="ANZEIGEN" 
                  TextAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button 
                   Background="#A3D2FF"
                   Grid.Column="0"
                   Grid.Row="3"
                   Height="80"
                   Width="150"  
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"            
                   FontSize="20"
                   FontWeight="Medium"
                   BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="LAGERPLATZ" 
                            TextAlignment="Center"/>

                    <TextBlock Text="HINZUFÜGEN" 
                            TextAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Column="1">
            <ListView/>
        </Grid>
    </Grid>
</Window>