<UserControl
    x:Class="BLG_Arbeitskleidung.Views.UserControls.EinlagernControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BLG_Arbeitskleidung.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BLG_Arbeitskleidung.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:EinlagernViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1250"    
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />            
        </Grid.RowDefinitions>

        <Button
            Grid.Row="1"
            Width="150"
            Height="60"
            VerticalAlignment="Center"
            Background="White"
            Command="{Binding EinlagernCommand}"
            Content="Speichern"
            FontSize="18"
            FontWeight="Medium" />

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>



            <Grid Grid.Column="0" Width="Auto">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Medium"
                    Text="Artikel-Nr.: " />

                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Größe: "
                    FontWeight="Medium"/>

                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Menge: *"
                    FontWeight="Medium"/>

                <TextBlock
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Lagerplatz: "
                    FontWeight="Medium"/>

                <TextBlock
                    Grid.Row="4"
                    VerticalAlignment="Top"
                    FontSize="18"
                    Text="Bemerkung: "
                    FontWeight="Medium"                    
                    />                
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ComboBox
                    Grid.Row="0"
                    Width="600"
                    Height="50"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    ItemsSource="{Binding Artikelnamen}"
                    SelectedItem="{Binding AusgewaehlteArtikelnamen}"
                    VerticalContentAlignment="Center"/>

                <ComboBox
                    Grid.Row="1"
                    Width="100"
                    Height="50"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    ItemsSource="{Binding Groeßen}"
                    SelectedItem="{Binding AusgwaehlteGroesse}"
                    VerticalContentAlignment="Center"/>

                <TextBox
                    Grid.Row="2"
                    Width="100"
                    Height="50"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    PreviewTextInput="OnMengeTextInput"
                    VerticalContentAlignment="Center"
                    Text="{Binding Menge, UpdateSourceTrigger=PropertyChanged}">

                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMengeLeer, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                    <Setter Property="BorderBrush" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ComboBox
                    Grid.Row="3"
                    Width="600"
                    Height="50"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="lpz_bezeichnung"
                    FontSize="18"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding Lagerplaetze}"
                    SelectedItem="{Binding AusgewaehlterLagerplatz}" 
                    />

                <TextBox
                    Grid.Row="4"
                    FontSize="18"
                    VerticalScrollBarVisibility="Visible"  
                    MaxWidth="600"
                    TextWrapping="Wrap"
                    Text="{Binding Bemerkung, UpdateSourceTrigger=PropertyChanged}"
                    />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
