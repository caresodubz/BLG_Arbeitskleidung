<UserControl
    x:Class="BLG_Arbeitskleidung.Views.UserControls.EinlagernControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BLG_Arbeitskleidung.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BLG_Arbeitskleidung.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:EinlagernViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1250"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="1"
            Width="150"
            Height="60"
            VerticalAlignment="Center"
            Background="White"
            Command="{Binding EinlagernCommand}"
            Content="SPEICHERN"
            FontSize="18"
            FontWeight="Medium" />

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>



            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Artikel-Nr.: " />

                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Größe: " />

                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Menge: " />

                <TextBlock
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Lagerplatz: " />

            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ComboBox
                    Grid.Row="0"
                    Width="600"
                    Height="50"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    ItemsSource="{Binding Artikelnamen}"
                    SelectedItem="{Binding SelectedArtikelnamen}" />

                <ComboBox
                    Grid.Row="1"
                    Width="100"
                    Height="50"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    ItemsSource="{Binding Größen}"
                    SelectedItem="{Binding SelectedGröße}" />

                <TextBox
                    Grid.Row="2"
                    Width="100"
                    Height="50"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    PreviewTextInput="OnMengeTextInput"
                    Text="{Binding Menge, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Grid.Row="3"
                    Width="600"
                    Height="50"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="lpz_bezeichnung"
                    FontSize="18"
                    ItemsSource="{Binding Lagerplätze}"
                    SelectedItem="{Binding SelectedLagerplatz}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
