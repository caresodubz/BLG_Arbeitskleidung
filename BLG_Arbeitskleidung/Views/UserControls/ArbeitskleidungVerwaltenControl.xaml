<UserControl x:Class="BLG_Arbeitskleidung.Views.UserControls.ArbeitskleidungVerwaltenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:viewmodels="clr-namespace:BLG_Arbeitskleidung.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1250"
             d:Background="White"
             d:DataContext="{d:DesignInstance Type=viewmodels:ArbeitskleidungVerwaltenViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
            
        </Grid.RowDefinitions>

        <Button
            Grid.Row="1"            
            Width="150"
            Height="60"
            Background="White"
            Content="Speichern"
            FontSize="18"
            FontWeight="Medium"
            Command="{Binding ArtikelHinzufügenCommand}"
            />

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>
                
            <TextBlock
                Grid.Row="0"
                Text="Artikelnummer: *"
                FontWeight="Medium"               
                FontSize="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                />
                
            <TextBlock
                Grid.Row="1"
                Text="Artikelname: *"
                FontWeight="Medium"                
                FontSize="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                />
            
            <TextBlock
                Grid.Row="2"
                Text="Größe: *"
                FontWeight="Medium"               
                FontSize="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                />

            <TextBlock
                Grid.Row="3"
                Text="Mindestbestand: *"
                FontWeight="Medium"               
                FontSize="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                />

            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <TextBox
                Grid.Row="0"    
                VerticalContentAlignment="Center"
                FontSize="18"  
                Margin="20,20,300,20"
                Text="{Binding Artikel_Nr, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Av_artikelnr, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                <Setter Property="BorderBrush" Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
                
            <TextBox
                Grid.Row="1"
                VerticalContentAlignment="Center"
                FontSize="18"
                Margin="20,20,300,20"
                Text="{Binding Artikel_Name, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Av_artikelname, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                <Setter Property="BorderBrush" Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
                
                
            <TextBox
                Grid.Row="2"
                VerticalContentAlignment="Center"
                FontSize="18"
                Margin="20,20,300,20"
                Text="{Binding Groesse, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Av_groesse, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                <Setter Property="BorderBrush" Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

                <TextBox
                        Grid.Row="3"
                        VerticalContentAlignment="Center"
                        FontSize="18"
                        Margin="20,20,300,20"
                        Text="{Binding Meldegrenze, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Av_meldegrenze, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                    <Setter Property="BorderBrush" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>