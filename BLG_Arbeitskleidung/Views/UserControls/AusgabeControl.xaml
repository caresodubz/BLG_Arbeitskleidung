<UserControl
    x:Class="BLG_Arbeitskleidung.Views.UserControls.AusgabeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:db="clr-namespace:Arbeitsbekleidung.Database.Database;assembly=Arbeitsbekleidung.Database"
    xmlns:local="clr-namespace:BLG_Arbeitskleidung.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BLG_Arbeitskleidung.ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodels:AusgabeViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1250"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96*" />
            <RowDefinition Height="37*" />
            <RowDefinition Height="Auto" MinHeight="135" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                x:Name="arbeitskleidungListe"
                AutoGenerateColumns="False"
                Background="White"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding Bestände}"
                SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding menge, Mode=OneWay}" Value="0">
                                <Setter Property="Background" Value="IndianRed" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="150"
                        Binding="{Binding Arbeitskleidung.DisplayArtikelName, Mode=OneWay}"
                        Header="Artikel Name (+Nummer)" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="150"
                        Binding="{Binding Arbeitskleidung.groesse}"
                        Header="Größe" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="150"
                        Binding="{Binding Lagerplatz.lpz_bezeichnung}"
                        Header="Lagerplatz" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding menge}"
                        Header="Bestand" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                x:Name="selectedArbeitskleidungListe"
                Grid.Column="2"
                AutoGenerateColumns="False"
                Background="White"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding SelectedBestände}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="150"
                        Binding="{Binding Arbeitskleidung.DisplayArtikelName, Mode=OneWay}"
                        Header="Artikel Name (+Nummer)" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="150"
                        Binding="{Binding Arbeitskleidung.groesse}"
                        Header="Größe" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="150"
                        Binding="{Binding Lagerplatz.lpz_bezeichnung}"
                        Header="Lagerplatz" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding menge}"
                        Header="Ausgewählt" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Medium"
                    Text="Menge:" />
                <TextBox
                    Grid.Row="2"
                    Height="50"
                    Margin="9,9"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="18"
                    PreviewTextInput="OnMengeTextInput"
                    Text="{Binding AddMenge, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Row="3"
                    Width="80"
                    Height="50"
                    Margin="9,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="White"
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{Binding ElementName=arbeitskleidungListe, Path=SelectedItem}"
                    Content="+"
                    FontSize="18"
                    FontWeight="Medium" />

                <Button
                    Grid.Row="4"
                    Width="80"
                    Height="50"
                    Margin="9,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="White"
                    Command="{Binding RemoveItemCommand}"
                    CommandParameter="{Binding ElementName=selectedArbeitskleidungListe, Path=SelectedItem}"
                    Content="-"
                    FontSize="18"
                    FontWeight="Medium" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Vorname: * "
                    FontWeight="Medium"/>

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Nachname: * " 
                    FontWeight="Medium"/>

                <TextBlock
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="Pers.-Nr.: * "
                    FontWeight="Medium"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    Grid.Row="1"
                    Width="500"
                    Height="30"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="{Binding Vorname, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VornameTextBox, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                    <Setter Property="BorderBrush" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBox
                    Grid.Row="2"
                    Width="500"
                    Height="30"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="{Binding Nachname, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NachnameTextBox, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                    <Setter Property="BorderBrush" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBox
                    Grid.Row="3"
                    Width="500"
                    Height="30"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="{Binding PersNummer, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PersNummerTextBox, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                    <Setter Property="BorderBrush" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Grid>

        <Button
            Grid.Row="2"
            Width="150"
            Height="60"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            Command="{Binding DruckenCommand}"
            Content="Ausgabeschein"
            FontSize="18"
            FontWeight="Medium" />
    </Grid>
</UserControl>