<UserControl x:Class="BLG_Arbeitskleidung.Views.UserControls.LogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:BLG_Arbeitskleidung.ViewModels"
             xmlns:models="clr-namespace:Arbeitsbekleidung.Models.Models;assembly=Arbeitsbekleidung.Models"            
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LogViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1250"
             d:Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Button
            Grid.Row="1"            
            Width="150"
            Height="60"
            Command="{Binding ExcelListe}"
            FontSize="18"
            FontWeight="Medium"            
            Background="White" Click="Button_Click">
            <StackPanel>
                <TextBlock Text="Log-Datei" TextAlignment="Center" />
                <TextBlock Text="erzeugen" TextAlignment="Center" />
            </StackPanel>
        </Button>

        <ListView ItemsSource="{Binding Logs}" Grid.Row="0">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Log}">
                    <Grid Margin="0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0">
                        <Run FontWeight="Bold" Text="Artikelname: " />
                        <Run Text="{Binding log_id, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Grid.Column="1" Margin="5,0">
                        <Run FontWeight="Bold" Text="Größen: " />
                        <Run Text="{Binding log_date, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Grid.Column="2" Margin="5,0">
                        <Run FontWeight="Bold" Text="Gesamtbestand: " />
                        <Run Text="{Binding log_bemerkung, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <DataGrid
            AutoGenerateColumns="False"
            Background="White"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            FontSize="14"
            IsReadOnly="True"
            ItemsSource="{Binding Logs}"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"              
            >           

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding log_funktion, Mode=OneWay}"
                    Header="Funktion" />

                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="80"
                    Binding="{Binding bearbeiter, Mode=OneWay}"
                    Header="Bearbeiter" />

                <DataGridTextColumn
                    Width="Auto"     
                    MinWidth="90"
                    Binding="{Binding log_date, Mode=OneWay}"
                    Header="Datum" />
                
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="120"
                    Binding="{Binding artikel, Mode=OneWay}"
                    Header="Artikel" />

                <DataGridTextColumn
                    Width="Auto"                    
                    Binding="{Binding log_stueckzahl, Mode=OneWay}"
                    Header="Stückzahl" />

                <DataGridTextColumn
                    Width="Auto"                    
                    Binding="{Binding log_groesse, Mode=OneWay}"
                    Header="Größe" />

                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="80"
                    Binding="{Binding person_nr, Mode=OneWay}"
                    Header="Personalnummer" />
                
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding log_lpz, Mode=OneWay}"
                    Header="Lagerplatz" />

                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="120"
                    Binding="{Binding log_bemerkung, Mode=OneWay}"
                    Header="Bemerkung" />                
            </DataGrid.Columns>            
        </DataGrid>
    </Grid>
</UserControl>