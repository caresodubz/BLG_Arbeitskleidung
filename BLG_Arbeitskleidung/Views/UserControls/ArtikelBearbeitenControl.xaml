<UserControl x:Class="BLG_Arbeitskleidung.Views.UserControls.ArtikelBearbeitenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BLG_Arbeitskleidung.Views.UserControls" 
             xmlns:models="clr-namespace:Arbeitsbekleidung.Models.Models;assembly=Arbeitsbekleidung.Models"             
             xmlns:viewmodels="clr-namespace:BLG_Arbeitskleidung.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ArtikelBearbeitenViewModel}"
             mc:Ignorable="d" 
             d:Background="White"
             d:DesignHeight="800" d:DesignWidth="1250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Button
            Grid.Row="1"            
            Width="150"
            Height="60"
            FontSize="18"
            Command="{Binding DatenbankÜberschreibenCommand}"
            FontWeight="Medium"            
            Background="White">
            <StackPanel>
                <TextBlock Text="Speichern" TextAlignment="Center" />                
            </StackPanel>
        </Button>

        <DataGrid
            AutoGenerateColumns="False"   
            Background="White"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"            
            FontSize="14"            
            ItemsSource="{Binding Kleidung}"            
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridTextColumn
                    IsReadOnly="False"
                    Width="Auto"
                    MinWidth="120"
                    Binding="{Binding artikel_name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Header="Artikel" />

                <DataGridTextColumn
                    IsReadOnly="False"                    
                    Width="Auto"
                    MinWidth="120"                    
                    Binding="{Binding artikel_nr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Header="Artikelnummer" />

                <DataGridTextColumn
                    IsReadOnly="False"
                    Width="Auto"  
                    Binding="{Binding groesse, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Header="Größe" />
                
                <DataGridTextColumn
                    IsReadOnly="False"
                    Width="*"                    
                    Binding="{Binding meldegrenze, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Header="Meldegrenze" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>