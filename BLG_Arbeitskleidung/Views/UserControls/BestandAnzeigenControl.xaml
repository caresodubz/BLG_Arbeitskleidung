<UserControl
    x:Class="BLG_Arbeitskleidung.Views.UserControls.BestandAnzeigenControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:db="clr-namespace:BLG_Arbeitskleidung.Database"
    xmlns:local="clr-namespace:BLG_Arbeitskleidung.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BLG_Arbeitskleidung.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:BestandAnzeigenViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1250"
    mc:Ignorable="d">
    <Grid>
        <ListView ItemsSource="{Binding Arbeitskleidungen}">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type db:Arbeitskleidung}">
                    <Grid Margin="0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0">
                                <Run FontWeight="Bold" Text="Artikelname: " />
                                <Run Text="{Binding DisplayArtikelName, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Grid.Column="1" Margin="5,0">
                                <Run FontWeight="Bold" Text="Größe: " />
                                <Run Text="{Binding groesse}" />
                            </TextBlock>

                            <TextBlock Grid.Column="2" Margin="5,0">
                                <Run FontWeight="Bold" Text="Gesamtbestand: " />
                                <Run Text="{Binding GesamtBestand, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            Margin="5,0,0,0"
                            BorderThickness="0"
                            ItemsSource="{Binding Bestände}">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type db:Bestand}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0">
                                            <Run FontWeight="Medium" Text="Lagerplatz: " />
                                            <Run Text="{Binding Lagerplatz.lpz_bezeichnung}" />
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Margin="10,0">
                                            <Run FontWeight="Medium" Text="Menge: " />
                                            <Run Text="{Binding menge}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <DataGrid
            AutoGenerateColumns="False"
            Background="White"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            FontSize="18"
            IsReadOnly="True"
            ItemsSource="{Binding Arbeitskleidungen}"
            VerticalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GesamtBestand, Mode=OneWay}" Value="5">
                            <Setter Property="Background" Value="IndianRed" />
                            <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GesamtBestand, Mode=OneWay}" Value="4">
                            <Setter Property="Background" Value="IndianRed" />
                            <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GesamtBestand, Mode=OneWay}" Value="3">
                            <Setter Property="Background" Value="IndianRed" />
                            <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GesamtBestand, Mode=OneWay}" Value="2">
                            <Setter Property="Background" Value="IndianRed" />
                            <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GesamtBestand, Mode=OneWay}" Value="1">
                            <Setter Property="Background" Value="IndianRed" />
                            <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GesamtBestand, Mode=OneWay}" Value="0">
                            <Setter Property="Background" Value="IndianRed" />
                            <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="120"
                    Binding="{Binding DisplayArtikelName, Mode=OneWay}"
                    Header="Artikelname" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="120"
                    Binding="{Binding groesse}"
                    Header="Größe" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="120"
                    Binding="{Binding GesamtBestand, Mode=OneWay}"
                    Header="Gesamtbestand" />
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate DataType="{x:Type db:Arbeitskleidung}">
                    <ListView
                        Grid.Row="1"
                        Margin="5,0,0,0"
                        BorderThickness="0"
                        ItemsSource="{Binding Bestände}">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type db:Bestand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0">
                                        <Run FontWeight="Medium" Text="Lagerplatz: " />
                                        <Run Text="{Binding Lagerplatz.lpz_bezeichnung}" />
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" Margin="10,0">
                                        <Run FontWeight="Medium" Text="Menge: " />
                                        <Run Text="{Binding menge}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</UserControl>