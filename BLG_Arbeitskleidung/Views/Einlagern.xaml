<Window x:Class="BLG_Arbeitskleidung.Views.Einlagern"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BLG_Arbeitskleidung.Views"
        mc:Ignorable="d"
        Title="Einlagern" Height="800" Width="1400" Background="#E9F0FF">
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#A3D2FF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button
                  Grid.Column="0"
                  Grid.Row="0"
                  Height="80"
                  Width="150"  
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Content="AUSGABE"
                  FontSize="20"
                  FontWeight="Medium"
                  BorderThickness="0"
                  Background="#E9F0FF"
                />

            <Button 
          Grid.Column="0"
          Grid.Row="1"
          Height="80"
          Width="150"  
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Content="EINLAGERN"
          FontSize="20"
          FontWeight="Medium"
          BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#A3D2FF"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E9F0FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button 
                  Background="#A3D2FF"
                  Grid.Column="0"
                  Grid.Row="2"
                  Height="80"
                  Width="150"  
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"            
                  FontSize="20"
                  FontWeight="Medium"
                  BorderThickness="0">
                
                <StackPanel>
                    <TextBlock Text="BESTAND" 
                 TextAlignment="Center"/>

                    <TextBlock Text="ANZEIGEN" 
                 TextAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button 
          Background="#A3D2FF"
          Grid.Column="0"
          Grid.Row="3"
          Height="80"
          Width="150"  
          VerticalAlignment="Center"
          HorizontalAlignment="Center"            
          FontSize="20"
          FontWeight="Medium"
          BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="LAGERPLATZ" 
                           TextAlignment="Center"/>

                    <TextBlock Text="HINZUFÜGEN" 
                           TextAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Button
                Grid.Row="1"
                Height="60"
                Width="150"
                VerticalAlignment="Center"
                Content="SPEICHERN"
                Background="White"
                FontWeight="Medium"
                FontSize="18"/>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock 
                          Grid.Row="0"
                          Text="Kleidungstyp: "
                          FontSize="18"
                          VerticalAlignment="Center"/>

                    <TextBlock 
                              Grid.Row="1"
                              Text="Größe: "
                              FontSize="18"
                              VerticalAlignment="Center"/>

                    <TextBlock 
                              Grid.Row="2"
                              Text="Menge: "
                              FontSize="18"
                              VerticalAlignment="Center"/>

                    <TextBlock 
                              Grid.Row="3"
                              Text="Lagerplatz: "
                              FontSize="18"
                              VerticalAlignment="Center"/>
                    
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox
                           Grid.Row="0"
                           Height="50"
                           Width="600"                           
                           IsReadOnly="True"
                           FontSize="18"
                           HorizontalAlignment="Left"/>

                    <ComboBox
                           Grid.Row="1"
                           Height="50"
                           Width="100"
                           IsReadOnly="True"
                           FontSize="18"
                           HorizontalAlignment="Left"/>

                    <TextBox
                          Grid.Row="2"
                          Height="50"
                          Width="100"
                          IsReadOnly="True"
                          FontSize="18"
                          HorizontalAlignment="Left"/>

                    <ComboBox
                           Grid.Row="3"
                           Height="50"
                           Width="600"
                           IsReadOnly="True"
                           FontSize="18"
                           HorizontalAlignment="Left"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
